{
  "name": "gitgraph-lab",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "preflight": "powershell -ExecutionPolicy Bypass -File ./scripts/preflight.ps1",
    "guardrails": "powershell -ExecutionPolicy Bypass -File ./scripts/enforce-guardrails.ps1",
    "quality:rust": "powershell -ExecutionPolicy Bypass -File ./scripts/quality-gate.ps1",
    "quality:rust:fast": "powershell -ExecutionPolicy Bypass -File ./scripts/quality-gate.ps1 -Fast",
    "quality:perf": "powershell -ExecutionPolicy Bypass -File ./scripts/perf-budget.ps1",
    "quality:perf:ingestion": "powershell -ExecutionPolicy Bypass -File ./scripts/perf-ingestion-budget.ps1",
    "perf:report": "powershell -ExecutionPolicy Bypass -File ./scripts/perf-report.ps1",
    "perf:report:smoke": "powershell -ExecutionPolicy Bypass -File ./scripts/perf-report.ps1 -Cycles 80 -FeatureCommits 4 -IncrementalCommits 20 -QueryRuns 10 -WindowLimit 200 -MaxNodes 2000 -OutputPath tmp/perf-report-smoke.txt",
    "perf:report:large": "powershell -ExecutionPolicy Bypass -File ./scripts/perf-report.ps1 -Cycles 700 -FeatureCommits 6 -IncrementalCommits 240 -QueryRuns 25 -WindowLimit 300 -MaxNodes 12000 -OutputPath tmp/perf-report-large.txt",
    "perf:report:25k": "powershell -ExecutionPolicy Bypass -File ./scripts/perf-report.ps1 -Cycles 2500 -FeatureCommits 6 -IncrementalCommits 2500 -QueryRuns 20 -WindowLimit 500 -MaxNodes 25000 -OutputPath tmp/perf-report-25k.txt",
    "perf:report:25k:precondition": "powershell -ExecutionPolicy Bypass -File ./scripts/perf-report.ps1 -Cycles 2500 -FeatureCommits 6 -IncrementalCommits 2500 -QueryRuns 20 -WindowLimit 500 -MaxNodes 25000 -PreconditionCommitGraph -OutputPath tmp/perf-report-25k-preconditioned.txt",
    "perf:report:90k": "powershell -ExecutionPolicy Bypass -File ./scripts/perf-report.ps1 -Cycles 9000 -FeatureCommits 6 -IncrementalCommits 9000 -QueryRuns 20 -WindowLimit 1000 -MaxNodes 90000 -PreconditionCommitGraph -OutputPath tmp/perf-report-90k.txt",
    "perf:ingestion:25k": "powershell -ExecutionPolicy Bypass -File ./scripts/perf-ingestion-budget.ps1",
    "perf:ingestion:90k": "powershell -ExecutionPolicy Bypass -File ./scripts/perf-ingestion-budget.ps1 -Profile 90k",
    "perf:ingestion:25k:warm": "powershell -ExecutionPolicy Bypass -File ./scripts/perf-ingestion-budget.ps1 -Lane warm",
    "perf:ingestion:90k:warm": "powershell -ExecutionPolicy Bypass -File ./scripts/perf-ingestion-budget.ps1 -Profile 90k -Lane warm",
    "test:layers": "powershell -ExecutionPolicy Bypass -File ./scripts/layer-test-matrix.ps1",
    "quality:rust:docker": "powershell -ExecutionPolicy Bypass -File ./scripts/quality-gate-docker.ps1",
    "quality:rust:docker:fast": "powershell -ExecutionPolicy Bypass -File ./scripts/quality-gate-docker.ps1 -Fast",
    "dev:gate": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-loop.ps1",
    "dev:gate:fast": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-loop.ps1 -Fast",
    "dev:gate:host": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-loop.ps1 -BackendMode host",
    "dev:gate:host:fast": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-loop.ps1 -BackendMode host -Fast",
    "safe:fast": "pnpm run guardrails && pnpm run dev:gate:fast",
    "safe:full": "pnpm run guardrails && pnpm run dev:gate"
  }
}
